{
  "name": "lovelyhawk-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm desktop:hot",
    "ui:build": "pnpm --filter @lovelyhawk/ui build",
    "ui:check": "pnpm --filter @lovelyhawk/ui check",
    "ui:test": "pnpm --filter @lovelyhawk/ui test",
    "ui:typecheck": "pnpm --filter @lovelyhawk/ui typecheck",
    "desktop:build": "pnpm --filter @lovelyhawk/ui desktop:build",
    "desktop:dev": "pnpm --filter @lovelyhawk/ui dev",
    "desktop:hot": "pnpm --filter @lovelyhawk/ui hot",
    "desktop:test:debug": "pnpm --filter @lovelyhawk/ui test:debug",
    "release:package": "pwsh -NoProfile -File ./scripts/desktop-package-windows.ps1",
    "release:validate": "pwsh -NoProfile -File ./scripts/desktop-validate-package.ps1",
    "release:smoke": "pwsh -NoProfile -File ./scripts/desktop-portable-smoke.ps1",
    "release:dependency-gate": "pwsh -NoProfile -File ./scripts/desktop-dependency-gate.ps1",
    "release:ledger-gate": "pwsh -NoProfile -File ./scripts/desktop-ui-ledger-gate.ps1",
    "release:ledger-gate:strict": "pwsh -NoProfile -File ./scripts/desktop-ui-ledger-gate.ps1 -RequireComplete",
    "release:source-gate": "pwsh -NoProfile -File ./scripts/desktop-source-gate.ps1",
    "release:quality-gate": "pwsh -NoProfile -File ./scripts/desktop-quality-gates.ps1",
    "release:quality-gate:strict": "pwsh -NoProfile -File ./scripts/desktop-quality-gates.ps1 -RequireComplete",
    "backend:harness": "cargo build --locked --package lovelyhawk-backend --bin lovelyhawk-backend",
    "lab:up": "pwsh -NoProfile -File ./scripts/lab-up.ps1",
    "lab:import": "node ./tools/lab/import-labs.mjs",
    "lab:remove": "node ./tools/lab/import-labs.mjs --remove",
    "lab:services": "pwsh -NoProfile -Command \"wsl.exe -d Ubuntu -u root -e bash -lc 'rm -rf /opt/lab-services && mkdir -p /opt/lab-services/misconfigure && cp /mnt/d/LovelyRes/tools/lab/services/Dockerfile /opt/lab-services/ && cp /mnt/d/LovelyRes/tools/lab/services/*.sh /opt/lab-services/ && cp /mnt/d/LovelyRes/tools/lab/services/misconfigure/*.sh /opt/lab-services/misconfigure/ && sed -i \\\"s/\r$//\\\" /opt/lab-services/*.sh /opt/lab-services/misconfigure/*.sh /opt/lab-services/Dockerfile && chmod +x /opt/lab-services/*.sh /opt/lab-services/misconfigure/*.sh && bash /opt/lab-services/build.sh'\"",
    "lab:verify": "node ./tools/lab/verify-services.mjs",
    "lab:paths": "node ./tools/lab/probe-paths.mjs",
    "lab:ui": "node ./tools/lab/probe-ui.mjs",
    "lab:ui-system-info": "node ./tools/lab/probe-ui-system-info.mjs",
    "lab:row-actions": "node ./tools/lab/probe-row-actions.mjs",
    "lab:startup-script": "node ./tools/lab/probe-startup-script.mjs",
    "lab:boot-script-runtime": "node ./tools/lab/probe-boot-script-runtime.mjs",
    "lab:ui-log-analysis": "node ./tools/lab/probe-ui-log-analysis.mjs",
    "lab:catalog-latency": "node ./tools/lab/probe-catalog-latency.mjs",
    "lab:table-truncation": "node ./tools/lab/probe-table-truncation.mjs",
    "lab:table-limits": "node ./tools/lab/probe-table-limits.mjs",
    "lab:missing-tools": "node ./tools/lab/probe-missing-tools.mjs",
    "lab:packet-capture": "node ./tools/lab/probe-packet-capture.mjs",
    "lab:refusals": "node ./tools/lab/probe-refusals.mjs",
    "lab:sftp-remove": "node ./tools/lab/probe-sftp-remove.mjs",
    "lab:sftp-upload-archive": "node ./tools/lab/probe-sftp-upload-archive.mjs",
    "lab:emergency-path": "node ./tools/lab/probe-emergency-path.mjs",
    "lab:system-info-mutations": "node ./tools/lab/probe-system-info-mutations.mjs",
    "lab:file-tables": "node ./tools/lab/probe-file-tables.mjs",
    "lab:tab-coverage": "node ./tools/lab/probe-tab-coverage.mjs",
    "lab:down": "wsl.exe -d Ubuntu -u root -e bash -lc \"docker stop $(docker ps -q --filter name=lab-)\"",
    "lab:restart": "pwsh -NoProfile -Command \"wsl.exe -d Ubuntu -u root -e bash -lc 'bash /mnt/d/LovelyRes/tools/lab/services/restart.sh' ; node ./tools/lab/import-labs.mjs\"",
    "lab:arena": "pwsh -NoProfile -Command \"wsl.exe -d Ubuntu -u root -e bash -lc 'rm -rf /opt/lab-arena && mkdir -p /opt/lab-arena && cp /mnt/d/LovelyRes/tools/lab/arena/* /opt/lab-arena/ && sed -i \\\"s/\r$//\\\" /opt/lab-arena/* && chmod +x /opt/lab-arena/*.sh && bash /opt/lab-arena/up.sh'\" ; node ./tools/lab/import-labs.mjs",
    "lab:verify-import": "node ./tools/lab/verify-import.mjs",
    "lab:versions": "node ./tools/lab/verify-versions.mjs",
    "lab:orchestration": "node ./tools/lab/orchestration/up.mjs && node ./tools/lab/import-labs.mjs",
    "lab:docker": "node ./tools/lab/probe-docker.mjs",
    "lab:kubernetes": "node ./tools/lab/probe-kubernetes.mjs",
    "lab:podman": "node ./tools/lab/probe-podman.mjs",
    "lab:container-arena": "node ./tools/lab/probe-container-arena.mjs",
    "lab:docker-terminal": "node ./tools/lab/probe-docker-terminal.mjs",
    "lab:docker-image": "node ./tools/lab/probe-docker-image.mjs",
    "lab:kubernetes-terminal": "node ./tools/lab/probe-kubernetes-terminal.mjs",
    "lab:container-files": "node ./tools/lab/probe-container-files.mjs",
    "lab:ui-kubernetes-tools": "node ./ui/scripts/probe-kubernetes-tools.mjs",
    "lab:kubernetes-containers": "node ./tools/lab/probe-kubernetes-containers.mjs",
    "lab:ui-kubernetes-containers": "node ./ui/scripts/probe-kubernetes-containers.mjs",
    "lab:kubernetes-rbac": "node ./tools/lab/probe-kubernetes-rbac.mjs",
    "lab:ui-kubernetes-rbac": "node ./ui/scripts/probe-kubernetes-rbac.mjs",
    "lab:kubernetes-pod-evidence": "node ./tools/lab/probe-kubernetes-pod-evidence.mjs",
    "lab:ui-kubernetes-pod-evidence": "node ./ui/scripts/probe-kubernetes-pod-evidence.mjs",
    "lab:kubernetes-manifest": "node ./tools/lab/probe-kubernetes-manifest.mjs",
    "lab:ui-kubernetes-manifest": "node ./ui/scripts/probe-kubernetes-manifest.mjs",
    "lab:ui-sftp-expiry": "node ./ui/scripts/probe-sftp-expiry.mjs",
    "lab:ui-config-layout": "node ./tools/lab/probe-ui-config-layout.mjs",
    "lab:ui-config-interactions": "node ./tools/lab/probe-ui-config-interactions.mjs",
    "lab:ui-config-goals": "node ./tools/lab/probe-ui-config-goals.mjs",
    "lab:check-audit-actions": "node ./tools/lab/probe-check-audit-actions.mjs",
    "lab:ui-check-audit-actions": "node ./tools/lab/probe-ui-check-audit-actions.mjs",
    "lab:baseline-actions": "node ./tools/lab/probe-baseline-actions.mjs",
    "lab:ui-baseline-actions": "node ./tools/lab/probe-ui-baseline-actions.mjs",
    "lab:ui-accessibility": "node ./tools/lab/probe-ui-accessibility.mjs",
    "lab:write": "node ./tools/lab/probe-baseline-write.mjs",
    "lab:sftp-edit": "node ./tools/lab/probe-sftp-edit.mjs",
    "lab:workbench-container": "node ./tools/lab/probe-workbench-container.mjs",
    "lab:workbench-pod": "node ./tools/lab/probe-workbench-pod.mjs"
  }
}
