{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-channel",
  "description": "Windows channel presentation: bounded view and intents, with no general backend or filesystem access.",
  "local": true,
  "windows": ["windows-channel"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize", "core:window:allow-is-maximized",
    "core:window:allow-start-dragging", "core:window:allow-close",
    "allow-windows-channel-child"
  ]
}
