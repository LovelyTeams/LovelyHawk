{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovelyres.invalid/schemas/gpui-feasibility-result-v1.json",
  "title": "LovelyRes GPUI Windows feasibility collected result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fixture",
    "generated_at_utc",
    "scenario",
    "build",
    "environment",
    "artifacts",
    "app_diagnostics",
    "operator_evidence",
    "checks",
    "outcome"
  ],
  "properties": {
    "schema": { "const": "lovelyres-feasibility-result/v1" },
    "fixture": { "type": "boolean" },
    "generated_at_utc": { "type": "string", "format": "date-time" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "build": { "$ref": "#/$defs/build" },
    "environment": { "$ref": "#/$defs/environment" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "app_diagnostics": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/appDiagnostics" }
      ]
    },
    "operator_evidence": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/operatorEvidence" }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 26,
      "items": { "$ref": "#/$defs/collectedCheck" }
    },
    "outcome": { "$ref": "#/$defs/outcome" }
  },
  "$defs": {
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operating_system",
            "dpi_percent",
            "mixed_dpi",
            "rdp",
            "virtual_machine",
            "integrated_gpu",
            "offline"
          ],
          "properties": {
            "operating_system": { "enum": ["Windows10-22H2", "Windows11"] },
            "dpi_percent": { "enum": [100, 150, 200] },
            "mixed_dpi": { "type": "boolean" },
            "rdp": { "type": "boolean" },
            "virtual_machine": { "type": "boolean" },
            "integrated_gpu": { "type": "boolean" },
            "offline": { "type": "boolean" }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "launch_path", "sha256", "size_bytes", "file_version", "pe_machine"],
      "properties": {
        "source_path": { "type": "string", "minLength": 1 },
        "launch_path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "file_version": { "type": ["string", "null"] },
        "pe_machine": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collected_at_utc", "os", "powershell", "session", "computer", "displays", "gpus", "network", "collection_errors"],
      "properties": {
        "collected_at_utc": { "type": "string", "format": "date-time" },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "version", "build_number", "display_version"],
          "properties": {
            "caption": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "build_number": { "type": ["integer", "null"], "minimum": 0 },
            "display_version": { "type": ["string", "null"] }
          }
        },
        "powershell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "architecture"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "architecture": { "type": "string", "minLength": 1 }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "client_name", "is_rdp"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "client_name": { "type": ["string", "null"] },
            "is_rdp": { "type": "boolean" }
          }
        },
        "computer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manufacturer", "model", "is_virtual_machine", "evidence"],
          "properties": {
            "manufacturer": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] },
            "is_virtual_machine": { "type": ["boolean", "null"] },
            "evidence": { "type": "string" }
          }
        },
        "displays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device_name", "primary", "left", "top", "width", "height", "dpi_percent"],
            "properties": {
              "device_name": { "type": "string" },
              "primary": { "type": "boolean" },
              "left": { "type": "integer" },
              "top": { "type": "integer" },
              "width": { "type": "integer", "minimum": 0 },
              "height": { "type": "integer", "minimum": 0 },
              "dpi_percent": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "driver_version", "adapter_compatibility", "pnp_device_id", "classification"],
            "properties": {
              "name": { "type": ["string", "null"] },
              "driver_version": { "type": ["string", "null"] },
              "adapter_compatibility": { "type": ["string", "null"] },
              "pnp_device_id": { "type": ["string", "null"] },
              "classification": { "enum": ["integrated", "discrete", "virtual", "unknown"] }
            }
          }
        },
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["is_offline", "probes"],
          "properties": {
            "is_offline": { "type": ["boolean", "null"] },
            "probes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["endpoint", "connected", "error"],
                "properties": {
                  "endpoint": { "type": "string" },
                  "connected": { "type": "boolean" },
                  "error": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "collection_errors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_directory", "smoke_marker", "app_result", "stdout_log", "stderr_log", "profile_root"],
      "properties": {
        "run_directory": { "type": "string" },
        "smoke_marker": { "type": "string" },
        "app_result": { "type": "string" },
        "stdout_log": { "type": "string" },
        "stderr_log": { "type": "string" },
        "profile_root": { "type": "string" }
      }
    },
    "appCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "appDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "generated_unix_ms",
        "app_version",
        "gpui_version",
        "operating_system",
        "architecture",
        "portable_data_root",
        "automatic_checks",
        "terminal_stress",
        "manual_checks"
      ],
      "properties": {
        "schema": { "const": "lovelyres-gpui-feasibility/v1" },
        "status": { "enum": ["READY", "FAILED"] },
        "generated_unix_ms": { "type": "integer", "minimum": 0 },
        "app_version": { "type": "string", "minLength": 1 },
        "gpui_version": { "const": "0.2.2" },
        "operating_system": { "const": "windows" },
        "architecture": { "type": "string", "minLength": 1 },
        "portable_data_root": { "type": "string", "minLength": 1 },
        "automatic_checks": { "type": "array", "minItems": 7, "items": { "$ref": "#/$defs/appCheck" } },
        "terminal_stress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_bytes", "processed_bytes", "elapsed_ms", "throughput_mib_per_second", "no_loss"],
          "properties": {
            "requested_bytes": { "type": "integer", "minimum": 1 },
            "processed_bytes": { "type": "integer", "minimum": 0 },
            "elapsed_ms": { "type": "integer", "minimum": 1 },
            "throughput_mib_per_second": { "type": "number", "minimum": 0 },
            "no_loss": { "type": "boolean" }
          }
        },
        "manual_checks": { "type": "array", "minItems": 14, "items": { "$ref": "#/$defs/appCheck" } }
      }
    },
    "operatorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "scenario_id", "binary_sha256", "operator", "recorded_at_utc", "checks"],
      "properties": {
        "schema": { "const": "lovelyres-feasibility-manual/v1" },
        "scenario_id": { "type": "string" },
        "binary_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "operator": { "type": "string", "minLength": 1 },
        "recorded_at_utc": { "type": "string", "format": "date-time" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/appCheck" } }
      }
    },
    "collectedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "status", "evidence", "source", "required_for_scenario"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "enum": ["harness", "environment", "app-automatic", "manual"] },
        "status": { "$ref": "#/$defs/status" },
        "evidence": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "required_for_scenario": { "type": "boolean" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_checks", "required_not_run_checks", "optional_not_run_checks"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "failed_checks": { "type": "array", "items": { "type": "string" } },
        "required_not_run_checks": { "type": "array", "items": { "type": "string" } },
        "optional_not_run_checks": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
