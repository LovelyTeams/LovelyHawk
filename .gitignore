# Build output and logs
/target/
artifacts/
*.log
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Security - prevent sensitive data from being committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.pfx
config/secrets.json
**/config/secrets.json
secrets/
**/secrets/

# Do not add broad filename globs such as `**/*token*` or `**/*secret*`.
# They miss real credential files and can silently hide legitimate source trees.
.codex-build-cache/*

.github/workflows/release.yml
tmp/*