{
  "name": "@lovelyhawk/ui",
  "version": "0.0.3",
  "private": true,
  "description": "LovelyHawk desktop user interface, served by the Tauri 2 host",
  "scripts": {
    "build": "vite build",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "desktop:build": "pnpm run build && cargo build --locked --package lovelyhawk-desktop",
    "dev": "pnpm run desktop:build && node scripts/launch-desktop.mjs",
    "hot": "node scripts/launch-desktop-hot.mjs",
    "test": "vitest run",
    "test:debug": "pnpm run desktop:build && node scripts/run-debug-smoke.mjs",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
